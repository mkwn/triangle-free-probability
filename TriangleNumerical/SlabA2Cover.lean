  obtain ⟨ha, hd, hb, hc⟩ := params2 h1 h2
  have h9 : (9:ℝ) ≤ h := le_trans (nine_le_value (by decide)) h1
  exact cube_bound_of_excludes (excludes2 h9 (le_refl _) ha hd hb hc)

end Itv
end TriangleNumerical
